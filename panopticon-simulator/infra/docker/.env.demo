# 서비스 이름 (Node.js 백엔드 서비스 이름)
SERVICE_NAME=ecommerce-backend

# Fluent-bit log collection endpoint
PANOPTICON_LOG_HOST=host.docker.internal
PANOPTICON_LOG_PORT=3005
PANOPTICON_LOG_URI=/producer/v1/logs

# OTLP trace collection endpoint
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:3005/producer/v1/traces

# Postgres 연결 정보
DATABASE_USER=panopticon
DATABASE_PASSWORD=panopticon
DATABASE_NAME=panopticon
DATABASE_PORT=5432
POSTGRES_PORT=5432

# 애플리케이션 포트 및 프론트엔드 환경 변수
BACKEND_PORT=3000
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_URL=http://localhost:3005/producer/v1/traces
