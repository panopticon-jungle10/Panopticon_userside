# 서비스 이름 (Node.js 백엔드 서비스 이름)
SERVICE_NAME=payment-service

# OTEL + Panopticon 관련
PANOPTICON_TRACE_ENDPOINT=https://your-trace-endpoint.example.com
PANOPTICON_LOG_ENDPOINT=https://your-log-endpoint.example.com
PANOPTICON_TENANT_ID=your-tenant-id
PANOPTICON_API_KEY=your-api-key

# OTEL Collector가 내부에서 사용할 OTLP export endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=${PANOPTICON_TRACE_ENDPOINT}

# Fluent Bit가 HTTP로 로그를 보낼 주소/포트/경로
PANOPTICON_LOG_HOST=your-log-host.example.com
PANOPTICON_LOG_PORT=443
PANOPTICON_LOG_URI=/logs

# Node.js 앱에서 Collector로 트레이스를 보낼 내부 OTLP HTTP endpoint
OTEL_COLLECTOR_OTLP_HTTP_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_COLLECTOR_PORT=4318

# 로그 파일 기본 경로 (컨테이너 내 경로)
LOG_FILE_PATH=/usr/src/app/logs/app.log

# 예시 DB URL (이미 있으면 유지)
DATABASE_URL=postgresql://appuser:apppassword@postgres:5432/ecommerce
DATABASE_USER=panopticon
DATABASE_PASSWORD=panopticon
DATABASE_NAME=panopticon
DATABASE_PORT=5432
POSTGRES_PORT=5432

# 애플리케이션 포트
BACKEND_PORT=3000
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://app:3000
